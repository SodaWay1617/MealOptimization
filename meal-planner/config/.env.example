# Copy this file to meal-planner/config/.env and fill real values.

# LLM provider:
# - mock
# - openai
# - openai_compatible
LLM_PROVIDER=mock

# OpenAI/OpenAI-compatible model name
LLM_MODEL=gpt-4o-mini

# API key for the selected provider
LLM_API_KEY=

# Base URL for OpenAI-compatible API
LLM_API_BASE=https://api.openai.com/v1

# OpenRouter example: use openai_compatible, https://openrouter.ai/api/v1,
# deepseek/deepseek-v4.1-flash-1017, and the optional provider below.
# LLM_OPENROUTER_PROVIDER=deepinfra

# Relative API path used by the client
LLM_API_PATH=/chat/completions

# Force JSON response_format when provider supports it
LLM_JSON_MODE=true

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=120

# Model temperature
LLM_TEMPERATURE=0.0

# Single JSONL log file for LLM requests/responses
LLM_LOG_PATH=logs/llm.log
